  "description": "NIRVEX / Velorant — Your Campus, Your Battlefield: Production-Grade Authoritative Online Multiplayer Tactical FPS",
  "main": "server/multiplayer_server.js",
  "scripts": {
    "start": "node server/multiplayer_server.js",
    "test": "node tests/multiplayer_modes.test.js",
    "test:live": "node tests/verify_multiplayer_live.js",
    "test:bench": "node tests/benchmark_load.js",
    "test:e2e": "python3 tests/two_browser_e2e.py",
